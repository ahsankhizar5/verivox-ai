# MongoDB
MONGODB_URI=mongodb://localhost:27017/verivox

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=verivox-audio-files

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# API
NEXT_PUBLIC_API_URL=http://localhost:3000
INFERENCE_SERVICE_URL=https://your-inference-service.com/api

# AssistX Audio Analysis API
ASSISTX_API_URL=https://ahsankhizar-assist-x-backend.hf.space/analyze
ASSISTX_API_KEY=your-assistx-api-key-here

# App
NODE_ENV=development
